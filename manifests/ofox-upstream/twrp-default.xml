<?xml version="1.0" encoding="UTF-8"?>
<manifest>
    <remote name="TeamWin"
            fetch="https://github.com/TeamWin"
            review="https://gerrit.twrp.me"/>

    <remote name="LineageOS"
            fetch="https://github.com/LineageOS"
            review="https://review.lineageos.org"/>

    <!-- OrangeFox-owned sources (patched sources + in-house TWRP forks) -->
    <remote name="OrangeFox"
            fetch="https://gitlab.com/OrangeFox"/>

    <remote name="github"
            fetch="https://github.com"/>

    <!-- We need the OrangeFox forks of these repos -->
    <remove-project name="platform/bionic"/>
    <remove-project name="platform/build" />
    <remove-project name="platform/build/soong" />
    <remove-project name="platform/cts" />
    <remove-project name="platform/external/icu" />
    <remove-project name="platform/external/libxml2" />
    <remove-project name="platform/external/sqlite" />
    <remove-project name="platform/external/libchrome" />
    <remove-project name="platform/external/zstd" />
    <remove-project name="platform/frameworks/hardware/interfaces" />
    <remove-project name="platform/hardware/interfaces"/>
    <remove-project name="platform/system/extras"/>
    <remove-project name="platform/system/libhidl" />
    <remove-project name="platform/system/security" />
    <remove-project name="platform/system/sepolicy" />
    <remove-project name="platform/system/update_engine" />
    <remove-project name="platform/system/vold" />
    <remove-project name="platform/external/rust/android-crates-io" />

    <!-- OrangeFox in-house forks of the TWRP build system -->
    <project path="build/make" name="build/make" remote="OrangeFox" revision="fox_16.0">
        <linkfile src="CleanSpec.mk" dest="build/CleanSpec.mk" />
        <linkfile src="buildspec.mk.default" dest="build/buildspec.mk.default" />
        <linkfile src="core" dest="build/core" />
        <linkfile src="envsetup.sh" dest="build/envsetup.sh" />
        <linkfile src="target" dest="build/target" />
        <linkfile src="tools" dest="build/tools" />
    </project>
    <project path="build/soong" name="build/soong" remote="OrangeFox" revision="fox_16.0">
        <linkfile src="root.bp" dest="Android.bp" />
        <linkfile src="bootstrap.bash" dest="bootstrap.bash" />
    </project>
    <project path="bionic" name="bionic" remote="OrangeFox" revision="fox_16.0"/>
    <project path="cts" name="cts" remote="OrangeFox" revision="fox_16.0"/>
    <project path="external/icu" name="external/icu" remote="OrangeFox" revision="fox_16.0"/>
    <project path="external/libxml2" name="external/libxml2" remote="OrangeFox" revision="fox_16.0"/>
    <project path="external/sqlite" name="external/sqlite" remote="OrangeFox" revision="fox_16.0"/>
    <project path="external/libchrome" name="external/libchrome" remote="OrangeFox" revision="fox_16.0"/>
    <project path="external/zstd" name="external/zstd" remote="OrangeFox" revision="fox_16.0"/>
    <project path="frameworks/hardware/interfaces" name="frameworks/hardware/interfaces" remote="OrangeFox" revision="fox_16.0"/>
    <project path="hardware/interfaces" name="hardware/interfaces" remote="OrangeFox" revision="fox_16.0" />
    <project path="system/libhidl" name="system/libhidl" remote="OrangeFox" revision="fox_16.0"/>
    <project path="system/sepolicy" name="system/sepolicy" remote="OrangeFox" revision="fox_16.0"/>
    <project path="system/security" name="system/security" remote="OrangeFox" revision="fox_16.0"/>
    <project path="system/update_engine" name="system/update_engine" remote="OrangeFox" revision="fox_16.0"/>
    <project path="system/vold" name="system/vold" remote="OrangeFox" revision="fox_16.0"/>
    <project path="system/extras" name="system/extras" remote="OrangeFox" revision="fox_16.0"/>

    <!-- TWRP vendor build system -->
    <project path="vendor/twrp" name="vendor/twrp" remote="OrangeFox" revision="fox_16.0" />

    <!-- Include fake OMAPI for the recovery -->
    <project name="external/se_omapi" path="external/se_omapi" remote="OrangeFox" revision="fox_16.0" />

    <!-- foxcli: the modern Rust `fox` CLI front-end (module "foxcli", stem "fox"),
         required by bootable/recovery (TWRP_REQUIRED_MODULES += foxcli). Replaces
         the legacy `twrp`-symlink CLI. -->
    <project name="external/foxcli" path="external/foxcli" remote="OrangeFox" revision="master" />

    <!-- OrangeFox snapshot fork of AOSP android-crates-io: adds recovery_available
         to the foxcli Rust deps (clap/serde_json chains + libc) so the recovery
         variant of `fox` links. Replaces the AOSP copy removed above. -->
    <project name="external/android-crates-io" path="external/rust/android-crates-io" remote="OrangeFox" revision="fox_16.0" />

    <!-- Include phh's treble repo for lptools support -->
    <project name="phhusson/vendor_lptools" path="external/lptools" remote="github" revision="master" />

    <!-- Include external/bash for bash support -->
    <project path="external/bash" name="android_external_bash" remote="LineageOS" revision="lineage-22.2"/>

    <!-- Include external/libncurses for bash and nano support -->
    <project path="external/libncurses" name="android_external_libncurses" remote="LineageOS" revision="lineage-22.2"/>

    <!-- Include external/nano for nano support -->
    <project path="external/nano" name="android_external_nano" remote="LineageOS" revision="lineage-22.2"/>

    <!-- Include ntfs_3g for NTFS support -->
    <project path="external/ntfs-3g" name="android_external_ntfs-3g" remote="LineageOS" revision="lineage-22.2"/>

    <!-- Include lineage-tools for lzma support -->
    <project path="prebuilts/tools-lineage" name="android_prebuilts_tools-lineage" remote="LineageOS" revision="lineage-22.2"/>

    <!-- Include external Magisk repo for repack binaries -->
    <project path="external/magisk-prebuilt" name="external_magisk-prebuilt" remote="TeamWin" revision="android-12.1"/>

    <!-- Qualcomm TWRP common tree: provides the qcom_decrypt / qcom_decrypt_fbe
         modules (init.recovery.qcom_decrypt.rc) that start qseecomd + the keymaster/
         keymint HALs in recovery. Required for FBE/FDE decryption on Qualcomm devices
         (imported by the Xiaomi device trees' init.recovery.qcom.rc).
         OrangeFox fork of TeamWin/android_device_qcom_twrp-common (android-14.1). -->
    <project path="device/qcom/twrp-common" name="device/qcom-twrp-common" remote="OrangeFox" revision="fox_16.0"/>

    <!-- OrangeFox-specific projects, removals and reference device trees -->
    <include name="fox.xml"/>

    <!-- LAST: Remove unused projects for minimal manifest -->
    <include name="remove-minimal.xml"/>
</manifest>
